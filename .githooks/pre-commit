#!/usr/bin/env bash
set -euo pipefail

hook_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
workspace_root="$(dirname "${hook_dir}")"
repo_root="$(git rev-parse --show-toplevel)"

if [[ "${repo_root}" != "${workspace_root}" ]]; then
  exec node "${workspace_root}/scripts/harness/pre-commit-validate.mjs"
fi

node "${workspace_root}/scripts/harness/pre-commit-validate.mjs"
exec node "${workspace_root}/scripts/harness/check-sync-drift.mjs" --staged
